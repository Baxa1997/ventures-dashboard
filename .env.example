# Copy to .env.local (git-ignored). Without any of these the panel runs on its sample data.

# ---------- Staff sign-in (public ids, not secrets; work in builds too) ----------
# With all three, people sign in with their ucode user (work email + password) and the
# panel reads and writes ucode with their token. `node scripts/ucode/auth.mjs list` prints them.
VITE_UCODE_PROJECT_ID=
VITE_UCODE_ENVIRONMENT_ID=
# The STAFF client type's id.
VITE_UCODE_CLIENT_TYPE_ID=

# ---------- The dev server's key (secret; `yarn dev` only) ----------
# For working on the test project before anyone has a user: the dev server forwards /ucode
# to the ucode admin API with this key, so the browser never holds it. Never put it in a
# VITE_ variable.
UCODE_API_KEY=
