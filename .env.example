# Copy to .env.local (git-ignored). Where staff sign in to ucode: public ids, not secrets,
# so they work in builds too. Without them the sign-in page says the panel is not connected.
# `node scripts/ucode/auth.mjs list` prints the client types; the project and environment
# ids are in ucode's project settings.

VITE_UCODE_PROJECT_ID=
VITE_UCODE_ENVIRONMENT_ID=
# The client types a user may belong to, tried in this order: STAFF (the fund's staff),
# then ADMIN (ucode's own admin users), comma-separated.
VITE_UCODE_CLIENT_TYPE_IDS=
